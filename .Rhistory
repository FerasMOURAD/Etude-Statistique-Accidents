generate_obs = function (n, p) {
x = matrix(nrow = n, ncol = p+1)
#soit on parcours les lignes
#for (i in 1:n){
#x[i,] = rnorm (n = p, mean = 3, sd = 1)
#}
#soit on parcours les colonnes
for (j in 1:p) {
x[,j] = rnorm (n = n, mean = 3, sd = 1)
}
Y = 6 -2 * x[,1] + 3 * x[,2] + rnorm (n = n, 0, 1)
ds = data.frame(x, Y)
}
